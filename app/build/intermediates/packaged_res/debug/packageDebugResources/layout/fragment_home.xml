<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:text="rrows"
            android:textColor="@color/navy"
            android:textSize="46sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Level 1"
        android:textColor="@color/accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStreakChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/navy"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="4" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_btn_primary"
        android:stateListAnimator="@null"
        android:text="Play"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
